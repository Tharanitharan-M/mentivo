# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Get these from your Neon project dashboard → Connection Details
DATABASE_URL="postgresql://user:pass@host-pooler.neon.tech/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host.neon.tech/dbname?sslmode=require"

# ─── Authentication (NextAuth v5) ────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth — create at console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── AI (Google Gemini) ──────────────────────────────────────────────────────
# Get from aistudio.google.com → Get API key
GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"

# ─── Observability (Langfuse) ─────────────────────────────────────────────────
# Get from cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY="pk-lf-..."
LANGFUSE_SECRET_KEY="sk-lf-..."
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"
LANGFUSE_BASEURL="https://us.cloud.langfuse.com"
