{
  "name": "mentivo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/roadmap-generate.yaml && NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/quiz-generate.yaml && NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/milestone-starter.yaml",
    "eval:roadmap": "NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/roadmap-generate.yaml",
    "eval:quiz": "NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/quiz-generate.yaml",
    "eval:starter": "NODE_OPTIONS='--import tsx/esm' promptfoo eval -c evals/milestone-starter.yaml",
    "eval:view": "promptfoo view"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.37",
    "@ai-sdk/react": "^3.0.114",
    "@auth/prisma-adapter": "^2.11.1",
    "@monaco-editor/react": "^4.7.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/adapter-neon": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/otel": "^2.1.1",
    "@vercel/speed-insights": "^1.3.1",
    "ai": "^6.0.112",
    "bcryptjs": "^3.0.3",
    "gsap": "^3.14.2",
    "langfuse-vercel": "^3.38.6",
    "next": "16.1.6",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.1",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.1",
    "prisma": "^7.4.2",
    "promptfoo": "^0.120.19",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.1"
  }
